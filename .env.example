# ---------------------------------------------------------------------------
# Copy to .env and edit. Every value has a safe default, so the app runs with
# no configuration at all — and a HOSTED instance needs no API key of its own,
# because students bring their own from the browser.
# ---------------------------------------------------------------------------

# --- LLM backend (server default; the browser can override per request) ------
# stub       deterministic, offline, no key   (default; what the suite runs on)
# groq       free tier, fast                  -> https://console.groq.com/keys
# cerebras   free tier                        -> https://cloud.cerebras.ai
# gemini     free Flash tier                  -> https://aistudio.google.com/apikey
# openrouter ':free' models                   -> https://openrouter.ai/keys
# mistral | together | xai | openai | anthropic
# ollama     local only, free forever         -> https://ollama.com
QTCAP_LLM_PROVIDER=stub
# QTCAP_LLM_MODEL=llama-3.3-70b-versatile
# GROQ_API_KEY=gsk_...
# CEREBRAS_API_KEY=csk-...
# GEMINI_API_KEY=AIza...
# OPENROUTER_API_KEY=sk-or-...
# XAI_API_KEY=xai-...
# MISTRAL_API_KEY=...
# TOGETHER_API_KEY=...
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# QTCAP_OLLAMA_HOST=http://localhost:11434
QTCAP_LLM_TEMPERATURE=0
QTCAP_LLM_MAX_TOKENS=1024

# --- Hosted instance ---------------------------------------------------------
# Turns on rate limiting, request-body caps and strict error redaction.
QTCAP_PUBLIC_MODE=0
QTCAP_RATE_PER_MIN=40
QTCAP_HEAVY_RATE_PER_MIN=8
QTCAP_MAX_BODY_BYTES=64000

# --- Findings notification (operator only, never student-supplied) -----------
# QTCAP_NOTIFY_WEBHOOK=https://hooks.slack.com/services/...
QTCAP_NOTIFY_MIN_SEVERITY=high

# --- Market data -------------------------------------------------------------
# auto     live APIs, then snapshot, then labelled synthetic (default)
# live     live only
# snapshot never call the network
QTCAP_MARKET_MODE=auto
QTCAP_ALLOW_STALE=1
QTCAP_MARKET_TIMEOUT=12
QTCAP_RISK_FREE_RATE=0.065

# --- Application behaviour ---------------------------------------------------
QTCAP_RAG_TOP_K=4
QTCAP_RAG_MIN_SCORE=0.06
QTCAP_AGENT_MAX_STEPS=6
QTCAP_MCP_TRANSPORT=in_process     # or: stdio

# --- Guardrails --------------------------------------------------------------
# The server default. The browser sends a per-request override, so one student
# turning guardrails off for a red-team lab never affects anyone else.
QTCAP_GUARDRAILS=1
QTCAP_VULNERABLE_MODE=0
